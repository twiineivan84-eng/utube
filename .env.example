# ================================================================
# TURIHAMWE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Institution: Nyamuyanja SACCO Ltd, Isingiro District, Uganda
# Purpose: Scheme administration, contributions, claims & welfare
# ================================================================

# ----------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING (Server)
# ----------------------------------------------------------------
# Execution environment: 'development' | 'production' | 'test'
NODE_ENV=development
# Internal HTTP port for the Node.js / Express server
PORT=3000
# Disable Vite HMR WebSocket in proxy/containerized preview environments (e.g., Google AI Studio)
DISABLE_HMR=true
# Canonical public URL of the application
APP_URL=https://turihamwe.nyamuyanjasacco.ug
# Allowed CORS origins for API requests (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://turihamwe.nyamuyanjasacco.ug

# ----------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite - Exposed to Browser)
# ----------------------------------------------------------------
# Relative or absolute endpoint prefix for API requests
VITE_API_BASE_URL=/api
# Organization and application branding
VITE_APP_NAME="Turihamwe Management System"
VITE_INSTITUTION_NAME="Nyamuyanja SACCO Ltd"
# Primary anchor branch code
VITE_DEFAULT_BRANCH=Nyamuyanja

# ----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Server-Only — Private)
# ----------------------------------------------------------------
# Cryptographically secure random 256-bit string (minimum 32 characters in production)
JWT_SECRET=dev-jwt-secret-turihamwe-sacco-enterprise-auth-key-min32chars
# JWT session validity duration (e.g., '8h', '12h', '24h')
JWT_EXPIRY=12h

# ----------------------------------------------------------------
# 4. CENTRAL POSTGRESQL DATABASE (Central Cloud Storage)
# ----------------------------------------------------------------
# Direct connection string for PostgreSQL (Isolated from core banking system)
DATABASE_URL=postgresql://turihamwe_user:dev_password@localhost:5432/turihamwe_db?sslmode=prefer
# Alternative individual PostgreSQL connection parameters:
PGHOST=localhost
PGPORT=5432
PGDATABASE=turihamwe_db
PGUSER=turihamwe_user
PGPASSWORD=dev_password

# ----------------------------------------------------------------
# 5. OFFLINE SQLITE LOCAL DATABASE & FILE REPOSITORY
# ----------------------------------------------------------------
# Authoritative path for branch-level offline SQLite cache
SQLITE_DATABASE_PATH=./data/turihamwe-local.sqlite
# Base directory for local persistent state files
DATA_STORAGE_DIR=./data
# Primary state snapshot filename
DATA_FILE_NAME=turihamwe_central_db.json

# ----------------------------------------------------------------
# 6. SMS GATEWAYS (PANDORA NETWORKS & AFRICA'S TALKING)
# ----------------------------------------------------------------
# Active SMS gateway provider: 'PANDORA' (Primary intended) | 'AFRICAS_TALKING' (Fallback)
SMS_PROVIDER=PANDORA

# Master toggle for outbound SMS dispatch ('true' | 'false')
SMS_ENABLED=true

# --- Pandora Networks SMS Gateway (Primary Intended Provider) ---
# Official API documentation: https://sms.thepandoranetworks.com/api
# Submission endpoint (POST)
PANDORA_SMS_API_URL=https://www.sms.thepandoranetworks.com/API/send_sms/
# Balance inquiry endpoint (POST)
PANDORA_SMS_BALANCE_URL=https://www.sms.thepandoranetworks.com/API/check_balance/
# Account username registered with Pandora Networks
PANDORA_SMS_USERNAME=
# Account password provided by Pandora Networks
PANDORA_SMS_PASSWORD=
# Alphanumeric Sender ID (GSM-7 standard max 11 alphanumeric chars)
PANDORA_SMS_SENDER_ID=NYAMUYANJA

# --- Africa's Talking Uganda Gateway (Secondary / Fallback Provider) ---
# Gateway environment: 'SANDBOX' for staging/dev or 'PRODUCTION' for live
SMS_ENVIRONMENT=SANDBOX
# Africa's Talking username ('sandbox' for dev, or registered SACCO account username)
AT_USERNAME=sandbox
# Africa's Talking API key (obtained from Africa's Talking dashboard)
AT_API_KEY=atsk_sandbox_development_key_placeholder
# Registered UCC Alpha Sender ID (defaults to 'TURIHAMWE')
AT_SENDER_ID=TURIHAMWE

# ----------------------------------------------------------------
# 7. DOCUMENT & FILE STORAGE
# ----------------------------------------------------------------
# Directory where claim verification documents and attachments are saved
FILE_STORAGE_PATH=./data/uploads
# Maximum allowed file upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ----------------------------------------------------------------
# 8. AUTOMATED BACKUPS & DISASTER RECOVERY
# ----------------------------------------------------------------
# Enable automated encrypted snapshot backups ('true' | 'false')
BACKUP_ENABLED=true
# Directory for storing encrypted database backups
BACKUP_STORAGE_DIR=./data/backups
# Cryptographic passkey for backup integrity and optional archive encryption
BACKUP_ENCRYPTION_KEY=dev_backup_integrity_key_32bytes_placeholder

# ----------------------------------------------------------------
# 9. BRANCH SYNCHRONIZATION
# ----------------------------------------------------------------
# Enable bidirectional offline transaction sync queue
SYNC_ENABLED=true
# Endpoint for branch transaction sync
SYNC_API_URL=/api/sync
# Polling and retry synchronization interval in seconds
SYNC_INTERVAL_SECONDS=30
